# =============================================================================
# RiseNext Voice AI Platform — example configuration
#
#   cp .env.example .env    then fill in real values
#
# RULES
#   - .env is git-ignored. NEVER commit real credentials.
#   - Every value here is a PLACEHOLDER. None of them work.
#   - Adding a new setting to the code means adding it here in the SAME change.
#   - Required settings are validated at startup; the process refuses to boot if
#     one is missing. Fail loudly at boot, never mysteriously at 2am on a call.
#   - Anything marked "DECISION REQUIRED" is unresolved — see PRD.md §12.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=local                       # local | dev | staging | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                      # console (local) | json (deployed)
SERVICE_NAME=rn-api                     # set per deployment unit: rn-api | rn-voice | rn-worker
DEBUG=false

# Public base URLs. The voice gateway's URL is handed to the telephony provider,
# so it must be publicly reachable over WSS (use a tunnel for local development).
API_BASE_URL=http://localhost:8000
VOICE_GATEWAY_PUBLIC_WS_URL=wss://your-tunnel.example.com
WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL
#
# TWO connection strings are required, and using the wrong one causes subtle bugs.
#   POOLED — transaction-mode pooler. All ordinary application traffic.
#            Session-level state does NOT survive: no `SET`, no `LISTEN/NOTIFY`,
#            no session advisory locks, no server-side PREPARE. Use `SET LOCAL`
#            inside an explicit transaction instead.
#   DIRECT — no pooler. Migrations, index builds, the scheduler's advisory-lock
#            leader lease, and anything needing session state.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://risenext:risenext@localhost:5432/risenext
DATABASE_URL_DIRECT=postgresql+asyncpg://risenext:risenext@localhost:5432/risenext
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Optional read replica for vector search. Replicas are asynchronous — never use
# one for a read-after-write flow the user can observe.
DATABASE_URL_REPLICA=

# -----------------------------------------------------------------------------
# Redis — coordination only. Nothing here is a source of truth.
# Losing Redis must degrade dispatch, never lose a call record.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1     # Taskiq stream broker
REDIS_RESULT_URL=redis://localhost:6379/2     # Taskiq result backend

# -----------------------------------------------------------------------------
# Identity — Clerk (behind the IdentityProvider seam in rn_providers)
#
# CLERK_JWT_KEY holds the PEM public key so token verification is networkless.
# Without it every authenticated request costs a JWKS round trip.
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Frontend (Next.js) — the publishable key is public by design; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# OpenAI — realtime voice, embeddings, post-call analysis
#
# NOTE: the Realtime *beta* interface was removed from the API in May 2026. Do not
# send an `OpenAI-Beta` header and do not copy pre-mid-2026 examples; the session
# audio-format config changed shape. Verify against current docs before coding.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini    # premium tier: gpt-realtime-2.1
OPENAI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime
OPENAI_ANALYSIS_MODEL=gpt-5.1
# DECISION REQUIRED (PRD D-8). The production embedding model, width and column
# type are NOT chosen — they are resolved in Phase 3 by a bake-off on real Indic
# and code-mixed data. See ADR-010. The values below are a development
# placeholder, not a commitment: once a width lands in a Postgres column type,
# changing it is a full re-embed AND a table rewrite for every tenant.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Sarvam — Indian-language STT/TTS for the cascaded fallback path
#
# Only used when an agent is configured for the cascaded pipeline, or as a
# fallback. Leave blank until Phase 4.
# -----------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix                 # the mode changes the SCRIPT the LLM sees — it is coupled to the prompt
SARVAM_TTS_MODEL=bulbul:v3

# -----------------------------------------------------------------------------
# Exotel — telephony (voice + WhatsApp)
#
# Host is region-specific: api.in.exotel.com is Mumbai.
# -----------------------------------------------------------------------------
EXOTEL_API_HOST=api.in.exotel.com
EXOTEL_ACCOUNT_SID=replace_me
EXOTEL_API_KEY=replace_me
EXOTEL_API_TOKEN=replace_me
EXOTEL_SUBSCRIBER_TOKEN=

# Status callbacks are NOT signed by the provider. Mitigation is layered:
# HTTPS + this high-entropy secret path segment + an IP allowlist obtained from
# provider support + strict schema validation. A webhook alone must never
# authorize anything with a financial effect. See SECURITY.md.
EXOTEL_WEBHOOK_PATH_SECRET=generate_a_long_random_string
EXOTEL_WEBHOOK_ALLOWED_IPS=

# Dial-rate ceiling. The provider documents 200 requests/minute on the connect
# endpoint; stay under it with headroom.
EXOTEL_DIAL_RATE_LIMIT_PER_MINUTE=150

# WhatsApp
EXOTEL_WHATSAPP_ENABLED=false
EXOTEL_WHATSAPP_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Audio
#
# Default telephony sample rate for new agents. 24000 avoids resampling on the
# OpenAI path and cuts outbound chunk-accumulation latency; 8000 is right for
# Sarvam-primary agents. This is per-agent config — the value here is only the
# default applied when an agent does not specify one. See ADR-003.
# -----------------------------------------------------------------------------
DEFAULT_TELEPHONY_SAMPLE_RATE=24000
AUDIO_RESAMPLER_QUALITY=HQ

# -----------------------------------------------------------------------------
# Object storage (S3-compatible) — uploads, exports, recordings
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT_URL=                   # blank for real AWS; set for MinIO/R2
STORAGE_BUCKET=risenext-voice-dev
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=replace_me
STORAGE_SECRET_ACCESS_KEY=replace_me
STORAGE_PRESIGNED_URL_TTL_SECONDS=900   # exports contain PII — keep links short-lived

# -----------------------------------------------------------------------------
# Concurrency budgets
#
# These are ADMISSION CONTROL, not capacity claims. Nothing here has been load
# tested. Do not raise them because a dashboard looks quiet — raise them after a
# load test with provisioned provider capacity. See PRD D-6.
# -----------------------------------------------------------------------------
MAX_CONCURRENT_CALLS_PLATFORM=20
MAX_CONCURRENT_CALLS_PER_ORGANIZATION=5
MAX_CALL_DURATION_SECONDS=1800
# Both the telephony stream and the model session have hard caps near 60 minutes,
# on independent clocks. Roll the session over before either is reached.
SESSION_ROLLOVER_AFTER_SECONDS=3000

# -----------------------------------------------------------------------------
# Compliance
#
# DECISION REQUIRED (PRD D-4): the permitted calling window and whether the
# telephony provider scrubs DND/NCPR server-side are BOTH unconfirmed. These
# values are placeholders pending confirmation, and they are configuration on
# purpose — never hardcode a regulatory constant.
# -----------------------------------------------------------------------------
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=21:00
CALLING_WINDOW_TIMEZONE=Asia/Kolkata
ENFORCE_CONSENT_GATE=true               # must remain true outside local development
ENFORCE_DND_CHECK=true
CALL_RECORDING_ENABLED=false            # DECISION REQUIRED (PRD D-5)
DATA_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Observability
#
# Traces carry call metadata. Point OTLP at our OWN collector — keep transcripts
# and caller PII out of third-party SaaS by default. Relevant to PRD D-1.
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rn-api
OTEL_TRACES_SAMPLER_ARG=1.0             # sample everything at low volume; always keep failures
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# LangSmith tracing is OFF. If tracing is ever enabled, route it through OTLP to
# our own collector rather than the hosted service.
LANGSMITH_TRACING=false
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_OTEL_ONLY=true
# Prevents arbitrary module loading from checkpoint payloads on a shared
# multi-tenant database. Keep this on.
LANGGRAPH_STRICT_MSGPACK=true

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=                        # post-call business automation ONLY — never in the conversation path
N8N_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Testing
#
# Live tests hit real, paid providers. They never run in CI. Test numbers must be
# internal and consented — never real customer data.
# -----------------------------------------------------------------------------
RUN_LIVE_PROVIDER_TESTS=false
TEST_PHONE_NUMBER=
